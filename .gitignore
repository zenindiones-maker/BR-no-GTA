# Python
.venv/
.venv.*/
__pycache__/
*.py[cod]
*.pyo

# Secrets / credentials
.env
.env.*
!.env.example
**/credentials/
**/tokens/
**/*.json

# Runtime
logs/*
!logs/.gitkeep

output/*
!output/.gitkeep

data/*
!data/.gitkeep
!data/*/.gitkeep

tmp/
cache/

# Backups
*.bak
*.backup
*.old

# Termux / local
.DS_Store

# Keep structural data directories
!data/database/
!data/database/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/raw/
!data/raw/.gitkeep

# SQLite database
*.db
*.db-shm
*.db-wal
