sunshine_name = {{ project_slug }}-workstation
address_family = both
origin_web_ui_allowed = pc
# pc = localhost-only Web UI per Sunshine configuration.
upnp = disabled
audio_sink = media-workstation-sink
stream_audio = enabled
lan_encryption_mode = 2
wan_encryption_mode = 2
# localhost Web UI remains local; Moonlight streaming rides Tailscale.
